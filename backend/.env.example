# GCP Configuration
GCP_PROJECT_ID=your-project-id
GCP_REGION=asia-south1
GCP_ZONE=asia-south1-a

# BigQuery
BQ_DATASET=ecommerce
BQ_ORDERS_TABLE=orders
BQ_INVENTORY_TABLE=inventory
BQ_USER_ACTIVITY_TABLE=user_activity
BQ_HEALING_TABLE=healing_events
BQ_TRAJECTORY_TABLE=trajectory_scores

# Pub/Sub
PUBSUB_RAW_TOPIC=raw-ecommerce-events
PUBSUB_ERROR_TOPIC=pipeline-errors

# GCS
GCS_LAKEHOUSE_BUCKET=PROJECT-ecommerce-lakehouse

# Firestore
FIRESTORE_DATABASE=(default)

# Vertex AI
VERTEX_AI_LOCATION=us-central1
GEMINI_FLASH_MODEL=gemini-3.7-flash
GEMINI_PRO_MODEL=gemini-2.5-pro

# Agent Thresholds
AUTO_APPROVE_CONFIDENCE=0.95
ESCALATION_CONFIDENCE=0.80
MAX_RETRIES=3
TOKEN_BUDGET_PER_HEAL=100000
TOKEN_BUDGET_PER_HOUR=1000000

# API
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000

# GitHub (Phase 2)
GITHUB_TOKEN=
GITHUB_REPO=

# Slack (Phase 3)
SLACK_WEBHOOK_URL=


